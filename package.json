{
  "name": "agent-session-history",
  "displayName": "Agent Session History",
  "description": "Browse local Claude Code and Codex session history by workspace, project, or all.",
  "version": "0.0.1",
  "publisher": "local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentSessionHistory",
          "title": "Agent Session History",
          "icon": "media/history.svg"
        }
      ]
    },
    "views": {
      "agentSessionHistory": [
        {
          "id": "agentSessionHistory.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentSessionHistory.sessions",
        "when": "agentSessionHistory.indexed && !agentSessionHistory.hasSessions",
        "contents": "No sessions found.\nCheck the Claude and Codex directory settings.\n[Open Settings](command:workbench.action.openSettings?%22agentSessionHistory%22)\n[Refresh](command:agentSessionHistory.refresh)"
      }
    ],
    "commands": [
      {
        "command": "agentSessionHistory.refresh",
        "title": "Refresh",
        "category": "Agent Session History",
        "icon": "$(refresh)"
      },
      {
        "command": "agentSessionHistory.scope.workspace",
        "title": "Show Workspace Sessions",
        "category": "Agent Session History",
        "icon": "$(folder)",
        "toggled": "agentSessionHistory.scope == workspace"
      },
      {
        "command": "agentSessionHistory.scope.project",
        "title": "Show Project Sessions",
        "category": "Agent Session History",
        "icon": "$(repo)",
        "toggled": "agentSessionHistory.scope == project"
      },
      {
        "command": "agentSessionHistory.scope.all",
        "title": "Show All Sessions",
        "category": "Agent Session History",
        "icon": "$(globe)",
        "toggled": "agentSessionHistory.scope == all"
      },
      {
        "command": "agentSessionHistory.search",
        "title": "Search Sessions",
        "category": "Agent Session History",
        "icon": "$(search)"
      },
      {
        "command": "agentSessionHistory.clearSearch",
        "title": "Clear Search",
        "category": "Agent Session History",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentSessionHistory.resume",
        "title": "Resume in Terminal",
        "category": "Agent Session History",
        "icon": "$(play)"
      },
      {
        "command": "agentSessionHistory.openTranscript",
        "title": "Open Transcript",
        "category": "Agent Session History",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentSessionHistory.copyId",
        "title": "Copy Session ID",
        "category": "Agent Session History"
      },
      {
        "command": "agentSessionHistory.reveal",
        "title": "Reveal Transcript in File Explorer",
        "category": "Agent Session History"
      },
      {
        "command": "agentSessionHistory.activateSelection",
        "title": "Resume Selected Session",
        "category": "Agent Session History"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentSessionHistory.scope.workspace",
          "when": "view == agentSessionHistory.sessions",
          "group": "navigation@1"
        },
        {
          "command": "agentSessionHistory.scope.project",
          "when": "view == agentSessionHistory.sessions",
          "group": "navigation@2"
        },
        {
          "command": "agentSessionHistory.scope.all",
          "when": "view == agentSessionHistory.sessions",
          "group": "navigation@3"
        },
        {
          "command": "agentSessionHistory.search",
          "when": "view == agentSessionHistory.sessions",
          "group": "navigation@5"
        },
        {
          "command": "agentSessionHistory.clearSearch",
          "when": "view == agentSessionHistory.sessions && agentSessionHistory.filtering",
          "group": "navigation@6"
        },
        {
          "command": "agentSessionHistory.refresh",
          "when": "view == agentSessionHistory.sessions",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "agentSessionHistory.resume",
          "when": "view == agentSessionHistory.sessions && viewItem =~ /^session\\./",
          "group": "inline@1"
        },
        {
          "command": "agentSessionHistory.resume",
          "when": "view == agentSessionHistory.sessions && viewItem =~ /^session\\./",
          "group": "1_session@1"
        },
        {
          "command": "agentSessionHistory.openTranscript",
          "when": "view == agentSessionHistory.sessions && viewItem =~ /^session\\./",
          "group": "1_session@2"
        },
        {
          "command": "agentSessionHistory.copyId",
          "when": "view == agentSessionHistory.sessions && viewItem =~ /^session\\./",
          "group": "2_copy@1"
        },
        {
          "command": "agentSessionHistory.reveal",
          "when": "view == agentSessionHistory.sessions && viewItem =~ /^session\\./",
          "group": "3_reveal@1"
        }
      ],
      "commandPalette": [
        {
          "command": "agentSessionHistory.resume",
          "when": "false"
        },
        {
          "command": "agentSessionHistory.openTranscript",
          "when": "false"
        },
        {
          "command": "agentSessionHistory.copyId",
          "when": "false"
        },
        {
          "command": "agentSessionHistory.reveal",
          "when": "false"
        },
        {
          "command": "agentSessionHistory.activateSelection",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agent Session History",
      "properties": {
        "agentSessionHistory.claudeDir": {
          "type": "string",
          "default": "~/.claude",
          "description": "Claude Code data directory that contains `projects/`."
        },
        "agentSessionHistory.codexDir": {
          "type": "string",
          "default": "~/.codex",
          "description": "Codex data directory that contains `sessions/` and `session_index.jsonl`."
        },
        "agentSessionHistory.includeNonInteractive": {
          "type": "boolean",
          "default": false,
          "description": "Also list non-interactive sessions such as `codex exec` and `claude --print`."
        },
        "agentSessionHistory.includeCodexArchived": {
          "type": "boolean",
          "default": false,
          "description": "Also scan Codex `archived_sessions/`."
        },
        "agentSessionHistory.maxLineBytes": {
          "type": "number",
          "default": 10485760,
          "minimum": 1024,
          "description": "Transcript lines larger than this many bytes are skipped."
        }
      }
    },
    "keybindings": [
      {
        "command": "agentSessionHistory.activateSelection",
        "key": "enter",
        "when": "focusedView == agentSessionHistory.sessions && listFocus && !inputFocus"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "npm run typecheck && npm run build",
    "test": "tsc --outDir out && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.100.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
