{
  "name": "agent-session-history",
  "displayName": "Agent Session History",
  "description": "Browse local Claude Code and Codex session history by workspace, project, or all.",
  "version": "0.0.2",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wonhao80016/agent-session-history.git"
  },
  "bugs": {
    "url": "https://github.com/wonhao80016/agent-session-history/issues"
  },
  "homepage": "https://github.com/wonhao80016/agent-session-history#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentSessionHistory",
          "title": "Agent Session History",
          "icon": "media/history.svg"
        }
      ]
    },
    "views": {
      "agentSessionHistory": [
        {
          "id": "agentSessionHistory.sessions",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "agentSessionHistory.refresh",
        "title": "Refresh",
        "category": "Agent Session History",
        "icon": "$(refresh)"
      },
      {
        "command": "agentSessionHistory.scope.workspace",
        "title": "Show Workspace Sessions",
        "category": "Agent Session History"
      },
      {
        "command": "agentSessionHistory.scope.project",
        "title": "Show Project Sessions",
        "category": "Agent Session History"
      },
      {
        "command": "agentSessionHistory.scope.all",
        "title": "Show All Sessions",
        "category": "Agent Session History"
      },
      {
        "command": "agentSessionHistory.search",
        "title": "Search Sessions",
        "category": "Agent Session History"
      },
      {
        "command": "agentSessionHistory.clearSearch",
        "title": "Clear Search",
        "category": "Agent Session History"
      },
      {
        "command": "agentSessionHistory.session.resume",
        "title": "Resume Session",
        "category": "Agent Session History"
      },
      {
        "command": "agentSessionHistory.session.resumeInTerminal",
        "title": "Resume in Terminal",
        "category": "Agent Session History"
      },
      {
        "command": "agentSessionHistory.session.openTranscript",
        "title": "Open Transcript",
        "category": "Agent Session History"
      },
      {
        "command": "agentSessionHistory.session.reveal",
        "title": "Reveal Transcript in File Explorer",
        "category": "Agent Session History"
      },
      {
        "command": "agentSessionHistory.session.copyId",
        "title": "Copy Session ID",
        "category": "Agent Session History"
      },
      {
        "command": "agentSessionHistory.session.moveToTrash",
        "title": "Move to Recycle Bin…",
        "category": "Agent Session History"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentSessionHistory.refresh",
          "when": "view == agentSessionHistory.sessions",
          "group": "navigation@9"
        }
      ],
      "webview/context": [
        {
          "command": "agentSessionHistory.session.resume",
          "when": "webviewId == 'agentSessionHistory.sessions' && webviewSection == 'session'",
          "group": "1_resume@1"
        },
        {
          "command": "agentSessionHistory.session.resumeInTerminal",
          "when": "webviewId == 'agentSessionHistory.sessions' && webviewSection == 'session'",
          "group": "1_resume@2"
        },
        {
          "command": "agentSessionHistory.session.openTranscript",
          "when": "webviewId == 'agentSessionHistory.sessions' && webviewSection == 'session'",
          "group": "2_inspect@1"
        },
        {
          "command": "agentSessionHistory.session.reveal",
          "when": "webviewId == 'agentSessionHistory.sessions' && webviewSection == 'session'",
          "group": "2_inspect@2"
        },
        {
          "command": "agentSessionHistory.session.copyId",
          "when": "webviewId == 'agentSessionHistory.sessions' && webviewSection == 'session'",
          "group": "3_copy@1"
        },
        {
          "command": "agentSessionHistory.session.moveToTrash",
          "when": "webviewId == 'agentSessionHistory.sessions' && webviewSection == 'session'",
          "group": "9_delete@1"
        }
      ],
      "commandPalette": [
        {
          "command": "agentSessionHistory.session.resume",
          "when": "false"
        },
        {
          "command": "agentSessionHistory.session.resumeInTerminal",
          "when": "false"
        },
        {
          "command": "agentSessionHistory.session.openTranscript",
          "when": "false"
        },
        {
          "command": "agentSessionHistory.session.reveal",
          "when": "false"
        },
        {
          "command": "agentSessionHistory.session.copyId",
          "when": "false"
        },
        {
          "command": "agentSessionHistory.session.moveToTrash",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agent Session History",
      "properties": {
        "agentSessionHistory.claudeDir": {
          "type": "string",
          "default": "~/.claude",
          "description": "Claude Code data directory that contains `projects/`."
        },
        "agentSessionHistory.codexDir": {
          "type": "string",
          "default": "~/.codex",
          "description": "Codex data directory that contains `sessions/` and `session_index.jsonl`."
        },
        "agentSessionHistory.includeNonInteractive": {
          "type": "boolean",
          "default": false,
          "description": "Also list non-interactive sessions such as `codex exec` and `claude --print`."
        },
        "agentSessionHistory.includeCodexArchived": {
          "type": "boolean",
          "default": false,
          "description": "Also scan Codex `archived_sessions/`."
        },
        "agentSessionHistory.maxLineBytes": {
          "type": "number",
          "default": 10485760,
          "minimum": 1048576,
          "description": "Transcript lines larger than this many bytes are skipped. Minimum 1 MiB, because smaller limits would drop whole sessions."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/webview",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "npm run typecheck && npm run build",
    "test": "tsc --outDir out && node --test \"out/test/**/*.test.js\"",
    "vscode:prepublish": "npm run check",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "session",
    "history"
  ]
}
